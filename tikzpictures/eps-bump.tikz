\begin{tikzpicture}
    \begin{axis}[
        axis lines=middle,
        xmin=0.2, xmax=3.2,
        ymin=-0.1, ymax=1.1,
        samples=200,
        domain=-2:4,
        width=7cm,
        height=4cm,
        legend style={at={(0.95,.5)}, anchor=south east},
        xtick={0.5, 1, 2, 2.5},
        ytick={0,1},
        xticklabels={\(a-\epsilon\), \(a\), \(b\), \(b+\epsilon\)},
        xticklabel style={text height=1.5ex}
    ]

    % Indicator function
    \addplot[
        thick,
        dashed
    ] {x <= 1 ? 0 : (x>2 ? 0: 1)};
    \addlegendentry{$\Indicator{[a,b]}$}

    % Lipschitz approximation
    \addplot[
        thick
    ] {
        x <= 0.5 ? 0 :
        (x >= 2.5 ? 0: 
        (x < 1 ? 2*(x-0.5) : 
        (x > 2 ? -2*(x-2) + 1 : 1)
        )
        )
    };
    \addlegendentry{$\Indicator{[a,b]}^{\vphantom{(}\epsilon}$}

    % Vertical reference lines
    \addplot[dotted] coordinates {(0.5,0) (0.5,1)};
    \addplot[dotted] coordinates {(2.5,0) (2.5,1)};

    \end{axis}
\end{tikzpicture}