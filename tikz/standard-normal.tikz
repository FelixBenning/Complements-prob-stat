\begin{tikzpicture}
    \begin{axis}[
        axis lines=middle,
        xmin=-3, xmax=3,
        ymin=-0.1, ymax=0.5,
        samples=200,
        domain=-2.8:2.8,
        width=7cm,
        height=4cm,
        xtick={-2, -1, 0, 1, 2},
        ytick={0.2},
        yticklabels={0.2},
        legend style={at={(0.95,.7)}, anchor=south east},
    ]

    % density
