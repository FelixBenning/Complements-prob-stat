\begin{tikzpicture}
    \begin{axis}[
        hide y axis,
        axis lines=middle,
        xmin=-3, xmax=3,
        ymin=-0.1, ymax=1.5,
        samples=200,
        domain=-2.8:2.8,
        width=12cm,
        height=5cm,
        xlabel=\(\epsilon\sqrt{n}\),
        xlabel style={below},
        xtick={-1, 1},
        extra x ticks = {0},
        xticklabels={
            \(-K\sqrt{n}\), \(K\sqrt{n}\)
        },
        legend style={at={(0.95,.7)}, anchor=south east},
    ]

    % density
    \addplot[thick] {
        abs(x) <1 ? exp(-x^2) : exp(-abs(x))
    };
    \draw[dashed] (axis cs:-1, 0) -- (axis cs:-1, 1.4);
    \draw[dashed] (axis cs:1, 0) -- (axis cs:1, 1.4);
    \draw[->] (axis cs:1.2, 0.55) -- (axis cs:2, 0.55);
    \draw[->] (axis cs: -1.2, 0.55) -- (axis cs: -2, 0.55);

    \node[align=left] at (axis cs: -2,1.2) {Large deviations\\exponential tails};
    \node[align=left] at (axis cs: 2,1.2) {Large deviations\\exponential tails};
    \node[align=left] at (axis cs: 0,1.2) {Typical deviations\\ (CLT)};
    \end{axis}
\end{tikzpicture}